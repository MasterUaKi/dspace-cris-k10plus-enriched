<?xml version="1.0" encoding="UTF-8"?>
<!--
    Version: 1.1.0 | Release Date: 2026-11-17
    [DE] Spring-Konfiguration für den K10plus + OpenAlex Enriched Live-Import-Provider (DSpace-CRIS 9)
    [EN] Spring configuration for K10plus + OpenAlex Enriched Live Import Provider (DSpace-CRIS 9)
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd"
       default-lazy-init="true">

    <bean id="k10plusMarcXmlParser"
          class="org.dspace.external.provider.parser.MarcXmlParser"/>

    <bean id="k10plusOpenAlexEnrichmentClient"
          class="org.dspace.external.provider.client.OpenAlexEnrichmentClient">
        <property name="baseUrl" value="${openalex.api.url:https://api.openalex.org/works}"/>
        <property name="politePoolEmail" value="${openalex.api.mailto:repository@example.org}"/>
        <property name="timeoutSeconds" value="8"/>
    </bean>

    <bean id="k10plusEnrichedMetadataSourceService"
          class="org.dspace.external.provider.impl.K10plusEnrichedDataProvider">
        <property name="sruBaseUrl" value="${k10plus.sru.url:https://sru.k10plus.de/opac-de-627}"/>
        <property name="importSourceName" value="K10plusEnriched"/>
        <property name="timeoutSeconds" value="12"/>
        <property name="marcXmlParser" ref="k10plusMarcXmlParser"/>
        <property name="openAlexEnrichmentClient" ref="k10plusOpenAlexEnrichmentClient"/>
        <property name="metadataFieldMapping" ref="openalexPublicationMetadataFieldMapping"/>
    </bean>

    <bean id="k10plusEnrichedLiveImportDataProvider"
          class="org.dspace.external.provider.impl.K10plusEnrichedExternalDataProvider">
        <property name="metadataSource" ref="k10plusEnrichedMetadataSourceService"/>
        <property name="sourceIdentifier" value="K10plusEnriched"/>
        <property name="recordIdMetadata" value="dc.identifier.other"/>
        <property name="supportedEntityTypes">
            <list>
                <value>Publications</value>
                <value>Publication</value>
                <value>none</value>
            </list>
        </property>
    </bean>

</beans>
